@page
@model MiniSmartstoreMvc.Areas.Identity.Pages.Account.RegisterModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>Đăng ký - MiniSmartstore</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth-double.css" asp-append-version="true" />
</head>

<body class="auth-double-body">
    <div class="auth-back-home">
        <a asp-area="" asp-controller="Home" asp-action="Index">
            ← Quay lại trang chủ
        </a>
    </div>

    <div class="auth-double-container right-panel-active" id="authContainer">
        <!-- ĐĂNG KÝ -->
        <div class="auth-form-container auth-sign-up-container">
            <form id="registerForm"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post"
                  class="auth-form">

                @Html.AntiForgeryToken()

                <h1>Tạo tài khoản</h1>
                <p class="auth-subtitle">Đăng ký tài khoản MiniSmartstore.</p>

                <div asp-validation-summary="ModelOnly" class="text-danger auth-validation"></div>

                <div class="auth-input-group">
                    <span class="auth-field-icon auth-icon-user"></span>
                    <input name="Input.FullName"
                           type="text"
                           placeholder="Họ tên của bạn"
                           autocomplete="name" />
                </div>

                <label>Email</label>
                <div class="auth-input-group">
                    <span class="auth-field-icon auth-icon-email"></span>
                    <input asp-for="Input.Email"
                           placeholder="Email"
                           autocomplete="username"
                           aria-required="true" />
                </div>
                <span asp-validation-for="Input.Email" class="text-danger"></span>

                <label>Mật khẩu</label>
                <div class="auth-input-group">
                    <span class="auth-field-icon auth-icon-lock"></span>
                    <input asp-for="Input.Password"
                           placeholder="Mật khẩu"
                           autocomplete="new-password"
                           aria-required="true" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger"></span>

                <label>Nhập lại mật khẩu</label>
                <div class="auth-input-group">
                    <span class="auth-field-icon auth-icon-check"></span>
                    <input asp-for="Input.ConfirmPassword"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password"
                           aria-required="true" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>

                <button id="registerSubmit" type="submit" class="auth-main-btn">
                    Đăng ký
                </button>

                <div class="auth-mobile-switch">
                    Đã có tài khoản?
                    <button type="button" id="mobileSignIn">
                        Đăng nhập
                    </button>
                </div>
            </form>
        </div>

        <!-- ĐĂNG NHẬP -->
        <div class="auth-form-container auth-sign-in-container">
            <form asp-area="Identity"
                  asp-page="/Account/Login"
                  asp-route-returnUrl="@Model.ReturnUrl"
                  method="post"
                  class="auth-form">

                @Html.AntiForgeryToken()

                <h1>Đăng nhập</h1>
                <p class="auth-subtitle">Bạn đã có tài khoản? Đăng nhập tại đây.</p>

                <label>Email</label>
                <div class="auth-input-group">
                    <span>✉️</span>
                    <input name="Input.Email"
                           type="email"
                           placeholder="Nhập email của bạn"
                           autocomplete="username"
                           required />
                </div>

                <label>Mật khẩu</label>
                <div class="auth-input-group">
                    <span>🔒</span>
                    <input name="Input.Password"
                           type="password"
                           placeholder="Nhập mật khẩu"
                           autocomplete="current-password"
                           required />
                </div>

                <button type="submit" class="auth-main-btn">
                    Đăng nhập
                </button>

                <div class="auth-mobile-switch">
                    Chưa có tài khoản?
                    <button type="button" id="mobileSignUp">
                        Đăng ký ngay
                    </button>
                </div>
            </form>
        </div>

        <!-- OVERLAY -->
        <div class="auth-overlay-container">
            <div class="auth-overlay">
                <div class="auth-overlay-panel auth-overlay-left">
                    <div class="auth-logo-box">
                        <span>M</span>
                        <strong>MiniSmartstore</strong>
                    </div>

                    <h1>Chào mừng trở lại!</h1>
                    <p>
                        Nếu bạn đã có tài khoản, hãy đăng nhập để tiếp tục sử dụng MiniSmartstore.
                    </p>

                    <button type="button" class="auth-ghost-btn" id="signIn">
                        Đăng nhập
                    </button>
                </div>

                <div class="auth-overlay-panel auth-overlay-right">
                    <div class="auth-logo-box">
                        <span>M</span>
                        <strong>MiniSmartstore</strong>
                    </div>

                    <h1>Bắt đầu mua sắm!</h1>
                    <p>
                        Tạo tài khoản để lưu giỏ hàng, địa chỉ nhận hàng và theo dõi đơn hàng.
                    </p>

                    <button type="button" class="auth-ghost-btn" id="signUp">
                        Đăng ký
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/auth-double.js" asp-append-version="true"></script>
</body>
</html>