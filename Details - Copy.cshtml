@model MiniSmartstoreMvc.Models.Product
@using MiniSmartstoreMvc.Models
@using System.Security.Claims
@{
    ViewData["Title"] = Model.Name;

    var galleryImages = new List<string>();

    if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        galleryImages.Add(Model.ImageUrl);
    }

    if (Model.ProductImages != null && Model.ProductImages.Any())
    {
        galleryImages.AddRange(
            Model.ProductImages
                .OrderBy(x => x.DisplayOrder)
                .ThenBy(x => x.Id)
                .Select(x => x.ImageUrl)
                .Where(x => !string.IsNullOrWhiteSpace(x))
        );
    }

    galleryImages = galleryImages
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .ToList();

    if (!galleryImages.Any())
    {
        galleryImages.Add("/images/products/no-image.jpg");
    }

    var mainImage = galleryImages.First();

    var discountPercent = 0;

    if (Model.OldPrice != null && Model.OldPrice > Model.Price)
    {
        discountPercent = (int)Math.Round((1 - Model.Price / Model.OldPrice.Value) * 100);
    }

    var deliveryTime = string.IsNullOrWhiteSpace(Model.DeliveryTime)
        ? "3 - 5 ngày"
        : Model.DeliveryTime;

    var productCode = string.IsNullOrWhiteSpace(Model.ProductCode)
        ? $"SP{Model.Id:000}"
        : Model.ProductCode;

    var approvedReviews = Model.ProductReviews?
        .Where(x => x.IsApproved)
        .OrderByDescending(x => x.CreatedAt)
        .ToList() ?? new List<ProductReview>();

    var reviewCount = approvedReviews.Count;

    var averageRating = reviewCount > 0
        ? approvedReviews.Average(x => x.Rating)
        : 0;

    var roundedAverage = (int)Math.Round(averageRating);

    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var hasCurrentUserReviewed = !string.IsNullOrWhiteSpace(currentUserId) &&
        (Model.ProductReviews?.Any(x => x.UserId == currentUserId) ?? false);

    var canReview = User.Identity?.IsAuthenticated == true && !hasCurrentUserReviewed;
}

<form id="drawerTokenForm" style="display:none">
    @Html.AntiForgeryToken()
</form>

<div class="container product-detail-smartstore-page">
    <nav class="product-detail-breadcrumb">
        <a asp-controller="Home" asp-action="Index" title="Trang chủ">
            <i class="bi bi-house-door"></i>
        </a>

        <span>/</span>

        <a asp-controller="Product"
           asp-action="Index"
           asp-route-categoryId="@Model.CategoryId">
            @Model.Category?.Name
        </a>

        <span>/</span>
        <span>@Model.Name</span>
    </nav>

    <section class="product-detail-smart-layout">
        <div class="product-detail-left">
            <div class="product-detail-gallery">
                <div class="product-detail-thumbs">
                    @for (int i = 0; i < galleryImages.Count; i++)
                    {
                        var image = galleryImages[i];

                        <button type="button"
                                class="product-detail-thumb @(i == 0 ? "active" : "")"
                                data-image="@image"
                                aria-label="Xem ảnh sản phẩm @(i + 1)">
                            <img src="@image"
                                 alt="@Model.Name"
                                 onerror="this.src='/images/products/no-image.jpg'" />
                        </button>
                    }
                </div>

                <div class="product-detail-image-box">
                    @if (discountPercent > 0)
                    {
                        <span class="product-detail-discount">-@discountPercent%</span>
                    }

                    <img id="productDetailMainImage"
                         src="@mainImage"
                         alt="@Model.Name"
                         onerror="this.src='/images/products/no-image.jpg'" />
                </div>
            </div>
        </div>

        <aside class="product-detail-right">
            <div class="product-detail-brand-icon">
                @(Model.Category?.Name?.FirstOrDefault().ToString().ToUpper() ?? "M")
            </div>

            <div class="product-detail-title-row">
                <div>
                    <h1>@Model.Name</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>@Model.Description</p>
                    }
                    else
                    {
                        <p>Sản phẩm thuộc danh mục @Model.Category?.Name</p>
                    }
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin"
                       asp-controller="Product"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="product-detail-edit-btn">
                        <i class="bi bi-pencil-fill"></i>
                        <span>Sửa</span>
                    </a>
                }
            </div>

            <div class="product-detail-rating">
                <span class="product-rating-stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span class="@(i <= roundedAverage ? "filled" : "")">★</span>
                    }
                </span>

                @if (reviewCount > 0)
                {
                    <a href="#reviewsTab" class="js-open-review-tab">
                        @averageRating.ToString("0.0")/5 từ @reviewCount đánh giá
                    </a>
                }
                else
                {
                    <a asp-controller="Product"
                       asp-action="Reviews"
                       asp-route-id="@Model.Id">
                        Hãy là người đầu tiên đánh giá sản phẩm này
                    </a>
                }
            </div>

            <div class="product-detail-buy-card">
                <div class="product-detail-price">
                    <strong>@Model.Price.ToString("N0") đ</strong>

                    @if (Model.OldPrice != null && Model.OldPrice > Model.Price)
                    {
                        <small>Giá cũ: @Model.OldPrice.Value.ToString("N0") đ</small>
                        <b>Tiết kiệm: @((Model.OldPrice.Value - Model.Price).ToString("N0")) đ</b>
                    }
                </div>

                <div class="product-detail-meta">
                    <div>
                        <strong>Giao hàng:</strong>
                        <span>@deliveryTime</span>
                    </div>

                    <div>
                        <strong>Tình trạng:</strong>

                        @if (Model.StockQuantity > 0)
                        {
                            <span class="text-success">Còn hàng - @Model.StockQuantity sản phẩm</span>
                        }
                        else
                        {
                            <span class="text-danger">Hết hàng</span>
                        }
                    </div>

                    <div>
                        <strong>Mã sản phẩm:</strong>
                        <span>@productCode</span>
                    </div>
                </div>

                @if (Model.StockQuantity > 0)
                {
                    <form id="detailAddCartForm"
                          class="product-detail-cart-form js-ajax-add-cart"
                          asp-controller="Cart"
                          asp-action="AddToCartAjax"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@Model.Id" />

                        @if (Model.ProductColors != null && Model.ProductColors.Any())
                        {
                            <div class="product-detail-option">
                                <label>Màu sắc *</label>

                                <div class="product-detail-color-list">
                                    @{
                                        var colorIndex = 0;
                                    }

                                    @foreach (var color in Model.ProductColors)
                                    {
                                        var isFirstColor = colorIndex == 0;

                                        <label class="product-detail-color-item" title="@color.ColorName">
                                            <input type="radio"
                                                   name="selectedColor"
                                                   value="@color.ColorName"
                                                   checked="@isFirstColor"
                                                   required />

                                            <span style="background-color: @color.ColorCode;"></span>
                                        </label>

                                        colorIndex++;
                                    }
                                </div>
                            </div>
                        }

                        <div class="product-detail-add-row">
                            <div class="product-detail-qty">
                                <label>Số lượng</label>

                                <select name="quantity">
                                    @for (int i = 1; i <= Math.Min(Model.StockQuantity, 10); i++)
                                    {
                                        <option value="@i">@i</option>
                                    }
                                </select>
                            </div>

                            <button type="submit" class="product-detail-add-cart">
                                <i class="bi bi-cart3"></i>
                                <span>Thêm vào giỏ hàng</span>
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <button type="button" class="product-detail-add-cart disabled" disabled>
                        Hết hàng
                    </button>
                }

                <div class="product-detail-action-bar">
                    <button type="button"
                            class="product-detail-action-item js-add-wishlist"
                            data-product-id="@Model.Id">
                        <i class="bi bi-heart"></i>
                        <span>Yêu thích</span>
                    </button>

                    <button type="button"
                            class="product-detail-action-item js-add-compare"
                            data-product-id="@Model.Id">
                        <i class="bi bi-arrow-left-right"></i>
                        <span>So sánh</span>
                    </button>

                    <a href="mailto:admin@mini.com?subject=Hỏi về sản phẩm @Model.Name"
                       class="product-detail-action-item">
                        <i class="bi bi-chat-square"></i>
                        <span>Câu hỏi?</span>
                    </a>

                    <button type="button"
                            class="product-detail-action-item js-share-product">
                        <i class="bi bi-share-fill"></i>
                        <span>Chia sẻ</span>
                    </button>
                </div>
            </div>
        </aside>
    </section>

    <section class="product-detail-tabs-wrapper">
        <div class="product-detail-tabs">
            <button type="button" class="active" data-tab="productDetailsTab">
                Chi tiết sản phẩm
            </button>

            <button type="button" data-tab="featuresTab">
                Tính năng
            </button>

            <button type="button" data-tab="reviewsTab">
                Đánh giá
            </button>
        </div>

        <div class="product-detail-tab-content active" id="productDetailsTab">
            <ul>
                <li>Tên sản phẩm: @Model.Name</li>
                <li>Danh mục: @Model.Category?.Name</li>
                <li>Mã sản phẩm: @productCode</li>
                <li>Số lượng tồn kho: @Model.StockQuantity</li>
                <li>Thời gian giao hàng: @deliveryTime</li>
                <li>Giao hàng toàn quốc.</li>
                <li>Hỗ trợ đổi trả theo chính sách cửa hàng.</li>
            </ul>
        </div>

        <div class="product-detail-tab-content" id="featuresTab">
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p>@Model.Description</p>
            }
            else
            {
                <p>Chưa có mô tả chi tiết cho sản phẩm này.</p>
            }
        </div>

        <div class="product-detail-tab-content" id="reviewsTab">
            <div class="product-review-panel">
                <div class="product-review-summary">
                    <div>
                        <h3>Đánh giá sản phẩm</h3>

                        @if (reviewCount > 0)
                        {
                            <p>
                                Trung bình <strong>@averageRating.ToString("0.0")/5</strong>
                                từ <strong>@reviewCount</strong> đánh giá.
                            </p>
                        }
                        else
                        {
                            <p>Chưa có đánh giá nào cho sản phẩm này.</p>
                        }
                    </div>

                    <div class="product-review-score">
                        <strong>@averageRating.ToString("0.0")</strong>

                        <span>
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="bi @(i <= roundedAverage ? "bi-star-fill filled" : "bi-star")"></i>
                            }
                        </span>
                    </div>
                </div>

                @if (approvedReviews.Any())
                {
                    <div class="product-review-list">
                        @foreach (var review in approvedReviews)
                        {
                            var reviewerName = review.User?.FullName;

                            if (string.IsNullOrWhiteSpace(reviewerName))
                            {
                                reviewerName = review.User?.Email ?? "Khách hàng";
                            }

                            var avatarLetter = reviewerName.Substring(0, 1).ToUpper();

                            <article class="product-review-item">
                                <div class="product-review-avatar">
                                    @avatarLetter
                                </div>

                                <div class="product-review-content">
                                    <div class="product-review-head">
                                        <div>
                                            <h4>@review.Title</h4>
                                            <p>@reviewerName · @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                        </div>

                                        <div class="product-review-stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <i class="bi @(i <= review.Rating ? "bi-star-fill filled" : "bi-star")"></i>
                                            }
                                        </div>
                                    </div>

                                    <p class="product-review-comment">@review.Comment</p>
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="product-detail-empty-review">
                        <h4>Chưa có đánh giá nào</h4>
                        <p>Hãy là người đầu tiên đánh giá sản phẩm này.</p>
                    </div>
                }

                <div class="product-review-write-box">
                    @if (canReview)
                    {
                        <div class="product-review-cta">
                            <a asp-controller="Product"
                               asp-action="Reviews"
                               asp-route-id="@Model.Id"
                               class="product-review-open-btn">
                                Đánh giá sản phẩm
                            </a>
                        </div>
                    }
                    else if (User.Identity?.IsAuthenticated == true && hasCurrentUserReviewed)
                    {
                        <div class="product-review-note">
                            Bạn đã đánh giá sản phẩm này rồi.
                        </div>
                    }
                    else
                    {
                        <div class="product-review-login-box">
                            <p>Bạn cần đăng nhập để đánh giá sản phẩm.</p>

                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               asp-route-returnUrl="@Url.Action("Reviews", "Product", new { id = Model.Id })">
                                Đăng nhập để đánh giá
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const mainImage = document.getElementById("productDetailMainImage");
            const thumbs = document.querySelectorAll(".product-detail-thumb");

            thumbs.forEach(function(button) {
                button.addEventListener("click", function() {
                    const image = button.dataset.image;

                    if (mainImage && image) {
                        mainImage.src = image;
                    }

                    thumbs.forEach(function(item) {
                        item.classList.remove("active");
                    });

                    button.classList.add("active");
                });
            });

            function openProductTab(tabId) {
                document.querySelectorAll(".product-detail-tabs button").forEach(function(item) {
                    item.classList.remove("active");
                });

                document.querySelectorAll(".product-detail-tab-content").forEach(function(item) {
                    item.classList.remove("active");
                });

                const button = document.querySelector('.product-detail-tabs button[data-tab="' + tabId + '"]');
                const tab = document.getElementById(tabId);

                if (button) {
                    button.classList.add("active");
                }

                if (tab) {
                    tab.classList.add("active");
                    tab.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            }

            document.querySelectorAll(".product-detail-tabs button").forEach(function(button) {
                button.addEventListener("click", function() {
                    openProductTab(button.dataset.tab);
                });
            });

            document.querySelectorAll(".js-open-review-tab").forEach(function(link) {
                link.addEventListener("click", function(event) {
                    event.preventDefault();
                    openProductTab("reviewsTab");
                    history.replaceState(null, "", "#reviewsTab");
                });
            });

            if (window.location.hash === "#reviewsTab") {
                openProductTab("reviewsTab");
            }
        });
    </script>
}